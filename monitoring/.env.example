# Telegram Configuratio
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Monitoring Configuration
MONITOR_URL=http://localhost:80
CHECK_INTERVAL=30
LOG_LEVEL=INFO
TARGET_DIR=/home/user/docker-compose-dir

# Maintenance Windows (optional, leave empty to disable)
# Format: HH:MM-HH:MM,HH:MM-HH:MM
MAINTENANCE_WINDOWS=03:00-03:15

# Error Threshold (must see this many 502s within window to alert)
ERROR_THRESHOLD=3
ERROR_WINDOW_SECONDS=180

# Recovery Commands (comma-separated)
RECOVERY_COMMANDS=systemctl status nginx,echo 'Command 2'